{
  "name": "arf-os",
  "private": true,
  "version": "0.1.0",
  "description": "ARF-OS - AI Research Hedge Fund Operating System (MVP vertical slice)",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @arf-os/db db:generate",
    "db:migrate": "pnpm --filter @arf-os/db db:migrate",
    "db:seed": "pnpm --filter @arf-os/db db:seed"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "@types/node": "^20.14.0"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
